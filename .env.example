# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不要提交。
# 生成随机值示例：openssl rand -base64 48

# ===== 必填：密钥和密码（源码中没有默认值，缺了服务无法启动）=====
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=markethub_user
MYSQL_PASSWORD=change-me
# HS256 至少 32 字节
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
# 网关与各服务之间的内部认证密钥，泄露后可绕过网关伪造任意用户身份
INTERNAL_AUTH_SECRET=change-me
# Redis 密码（对应 redis-server --requirepass）
REDIS_PASSWORD=change-me
# RabbitMQ 账号。不要用默认的 guest/guest；用户名只放字母数字，避免特殊字符带来的转义问题
RABBIT_USER=change-me
RABBIT_PASS=change-me

# ===== 可选 =====
# 上 https 后改为 true
AUTH_COOKIE_SECURE=false
# 允许带 Cookie 跨域访问网关的前端地址，逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:5173
# 未付款订单自动取消的延时（毫秒），默认 30 分钟。测试超时取消时可临时调成 10000
ORDER_PAY_TIMEOUT_MS=1800000

# ===== AI 助手（实验五）=====
# Ollama 装在宿主机、不在 compose 里，所以容器要走 host.docker.internal 才能连上它。
# Ollama 默认只监听 127.0.0.1，启动前必须设 OLLAMA_HOST=0.0.0.0，否则容器连接会被拒绝。
# 本机直接 mvn spring-boot:run 跑 ai-service 时不用改这里，application.yml 默认就是 localhost。
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_CHAT_MODEL=qwen2.5:7b
AI_EMBEDDING_MODEL=bge-m3

# ===== 仅在本机直接 mvn spring-boot:run 时使用（Docker 内会自动指向容器名）=====
NACOS_ADDR=localhost:8848
REDIS_HOST=localhost
REDIS_PORT=6379
RABBIT_HOST=localhost
RABBIT_PORT=5672
SENTINEL_DASHBOARD=localhost:8718
# recommend/engine/train.py 也读这几个变量（用户和密码复用上面的 MYSQL_USER / MYSQL_PASSWORD）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=market_hub
